---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import { getCollection } from 'astro:content'

const projects = await getCollection('projects')
const tagMap = new Map<string, number>()
projects.forEach((p) =>
  p.data.tags.forEach((t) => tagMap.set(t, (tagMap.get(t) ?? 0) + 1))
)
const tags = Array.from(tagMap.entries()).sort((a, b) => b[1] - a[1])
---

<Layout
  title="Browse Tags — OpenRadar"
  description="Explore open-source projects by category. Find tools by tags like AI, Python, CLI, and more."
>
  <Header />

  <main class="container-main py-14">
    <nav class="flex items-center gap-2 label mb-12" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent transition-colors">Index</a>
      <span class="text-line-strong">/</span>
      <span class="text-ink">Tags</span>
    </nav>

    <header class="border-b border-ink pb-12 mb-4">
      <p class="label flex items-center gap-3 mb-6"><span class="tick"></span>Catalog</p>
      <h1 class="font-display mb-6" style="line-height: 1.0;">Browse by tag</h1>
      <p class="text-lg text-ink-2 max-w-2xl">
        {tags.length} categories across {projects.length} indexed projects.
        Pick a thread and follow it.
      </p>
    </header>

    <ul>
      {tags.map(([tag, count], i) => (
        <li>
          <a
            href={`/tags/${tag}`}
            class="group grid grid-cols-[2.5rem_1fr_auto] items-baseline gap-4 sm:gap-6 py-5 border-b border-line transition-colors hover:bg-card"
          >
            <span class="label text-ink-3 tabular-nums">{String(i + 1).padStart(2, '0')}</span>
            <span class="font-display text-2xl sm:text-3xl leading-none group-hover:text-accent transition-colors">
              <span class="text-ink-3">#</span>{tag}
            </span>
            <span class="label whitespace-nowrap inline-flex items-center gap-2">
              {count} project{count !== 1 ? 's' : ''}
              <span class="inline-block transition-transform group-hover:translate-x-1 text-ink group-hover:text-accent" aria-hidden="true">&rarr;</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </main>

  <Footer />
</Layout>
