---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import TagBadge from '../../components/TagBadge.astro'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const projects = await getCollection('projects')
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }))
}

const { project } = Astro.props
const { Content } = await render(project)

// Get related projects (same tags)
const allProjects = await getCollection('projects')
const related = allProjects
  .filter((p) => p.id !== project.id && p.data.tags.some((t) => project.data.tags.includes(t)))
  .slice(0, 3)
---

<Layout title={`${project.data.name} — OpenRadar`} description={project.data.description}>
  <Header />
  <main class="container-main py-16">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-text-muted mb-10">
      <a href="/" class="hover:text-accent transition-colors">Home</a>
      <span class="text-text-muted/40">/</span>
      <span class="text-text-secondary">{project.data.name}</span>
    </nav>

    <!-- Project Header -->
    <div class="glass-card p-8 mb-10">
      <div class="flex items-start justify-between gap-4 mb-5">
        <h1 class="text-3xl font-extrabold font-display text-text-primary">{project.data.name}</h1>
        {project.data.language && (
          <span class="text-sm font-mono text-text-muted px-3 py-1.5 rounded-lg bg-surface-0/50 border border-white/[0.04] shrink-0">
            {project.data.language}
          </span>
        )}
      </div>

      <p class="text-lg text-text-secondary leading-relaxed mb-8">{project.data.description}</p>

      <div class="flex flex-wrap gap-2.5 mb-8">
        {project.data.tags.map((tag) => (
          <TagBadge name={tag} />
        ))}
      </div>

      <div class="flex items-center gap-6 pt-5 border-t border-white/[0.06]">
        {project.data.stars !== undefined && (
          <div class="flex items-center gap-2 text-sm text-text-muted">
            <svg class="w-4 h-4 text-warning" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
            <span>{project.data.stars?.toLocaleString()} stars</span>
          </div>
        )}
        {project.data.forks !== undefined && (
          <div class="flex items-center gap-2 text-sm text-text-muted">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
            <span>{project.data.forks?.toLocaleString()} forks</span>
          </div>
        )}
        <a
          href={project.data.url}
          target="_blank"
          rel="noopener noreferrer"
          class="ml-auto inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-accent/10 border border-accent/20 text-accent text-sm font-medium hover:bg-accent/20 transition-colors"
        >
          View on GitHub →
        </a>
      </div>
    </div>

    <!-- Project Content -->
    <article class="glass-card p-8 mb-14 prose-dark max-w-3xl">
      <Content />
    </article>

    <!-- Related Projects -->
    {related.length > 0 && (
      <section>
        <div class="flex items-center gap-3 mb-8">
          <div class="w-1.5 h-6 rounded-full bg-accent" />
          <h2 class="font-bold font-display">Related Projects</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {related.map((p) => (
            <a href={`/projects/${p.id}`} class="glass-card group block p-6 no-underline hover:no-underline">
              <h3 class="text-base font-semibold text-text-primary group-hover:text-accent transition-colors font-display mb-3">
                {p.data.name}
              </h3>
              <p class="text-sm text-text-secondary line-clamp-2" style="line-height: 1.6;">{p.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
  <Footer />
</Layout>
