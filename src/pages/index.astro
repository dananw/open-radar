---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import ProjectCard from '../components/ProjectCard.astro'
import SearchBar from '../components/SearchBar'
import { getCollection } from 'astro:content'

const allProjects = await getCollection('projects')
const featured = allProjects.filter((p) => p.data.featured)
const sorted = allProjects.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
)

const searchData = sorted.map((p) => ({
  name: p.data.name,
  description: p.data.description,
  slug: p.id,
  tags: p.data.tags,
  stars: p.data.stars,
  language: p.data.language,
}))

const totalStars = allProjects.reduce((sum, p) => sum + (p.data.stars ?? 0), 0)
const uniqueTags = new Set(allProjects.flatMap((p) => p.data.tags)).size
const lastUpdated = sorted[0]?.data.publishedAt.toLocaleDateString('en-US', {
  month: 'short',
  year: 'numeric',
})

const stats = [
  { value: String(allProjects.length).padStart(2, '0'), label: 'Projects indexed' },
  { value: String(uniqueTags), label: 'Categories' },
  { value: `${(totalStars / 1000).toFixed(0)}k`, label: 'Combined stars' },
]
---

<Layout>
  <Header />

  <main>
    <!-- Hero -->
    <section class="border-b border-line">
      <div class="container-main pt-20 pb-16">
        <p class="label flex items-center gap-3 mb-9">
          <span class="tick"></span>
          The open-source index{lastUpdated && <span class="text-ink-2">· Updated {lastUpdated}</span>}
        </p>

        <h1 class="font-display max-w-4xl mb-8" style="line-height: 1.0;">
          The open-source projects<br />
          worth your <span class="italic text-accent">attention</span>.
        </h1>

        <p class="text-lg text-ink-2 max-w-2xl">
          A hand-curated field guide to trending tools and libraries. No vanity
          rankings, no sponsored slots — just honest field notes on software
          people actually reach for.
        </p>
      </div>
    </section>

    <!-- Stats strip -->
    <section class="border-b border-line">
      <div class="container-main grid grid-cols-3">
        {stats.map((s, i) => (
          <div class={`py-8 ${i > 0 ? 'pl-6 sm:pl-10 border-l border-line' : 'pr-6'}`}>
            <div class="font-display text-3xl sm:text-5xl leading-none mb-2">{s.value}</div>
            <div class="label">{s.label}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Featured -->
    {featured.length > 0 && (
      <section class="container-main pt-20">
        <div class="flex items-baseline justify-between gap-4 mb-10 pb-4 border-b border-ink">
          <h2 class="font-display text-3xl flex items-center gap-3">
            <span class="tick"></span>Featured
          </h2>
          <span class="label">{String(featured.length).padStart(2, '0')} selected</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {featured.map((project, i) => (
            <ProjectCard
              name={project.data.name}
              description={project.data.description}
              url={project.data.url}
              stars={project.data.stars}
              forks={project.data.forks}
              language={project.data.language}
              tags={project.data.tags}
              slug={project.id}
              index={i + 1}
            />
          ))}
        </div>
      </section>
    )}

    <!-- All projects + search -->
    <section class="container-main pt-20 pb-8" id="all-projects">
      <div class="flex items-baseline justify-between gap-4 mb-10 pb-4 border-b border-ink">
        <h2 class="font-display text-3xl flex items-center gap-3">
          <span class="tick"></span>The index
        </h2>
        <span class="label">A–Z by recency</span>
      </div>

      <div class="mb-12">
        <SearchBar client:load projects={searchData} />
      </div>

      <div
        id="projects-grid"
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5"
      >
        {sorted.map((project, i) => (
          <div class="project-item flex" data-slug={project.id}>
            <ProjectCard
              name={project.data.name}
              description={project.data.description}
              url={project.data.url}
              stars={project.data.stars}
              forks={project.data.forks}
              language={project.data.language}
              tags={project.data.tags}
              slug={project.id}
              index={i + 1}
            />
          </div>
        ))}
      </div>

      <div id="projects-empty" class="hidden py-20 text-center">
        <p class="font-display text-2xl mb-2">Nothing on the radar.</p>
        <p class="label">Try a different keyword or clear the filters</p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const items = Array.from(
    document.querySelectorAll<HTMLElement>('.project-item')
  )
  const empty = document.getElementById('projects-empty')

  window.addEventListener('search-results', ((e: Event) => {
    const { slugs, count } = (e as CustomEvent).detail as {
      slugs: string[]
      count: number
    }
    const visible = new Set(slugs)
    items.forEach((el) => {
      el.style.display = visible.has(el.dataset.slug ?? '') ? '' : 'none'
    })
    empty?.classList.toggle('hidden', count !== 0)
  }) as EventListener)
</script>
