---
const path = Astro.url.pathname
const isHome = path === '/'
const isTags = path.startsWith('/tags')
---

<header class="sticky top-0 z-50 bg-paper/85 backdrop-blur-md border-b border-line">
  <div class="container-main flex items-center justify-between h-[4.25rem]">
    <a href="/" class="flex items-center gap-3 group">
      <span class="relative inline-flex">
        <svg class="w-7 h-7 text-ink" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4">
          <circle cx="16" cy="16" r="13.5" />
          <circle cx="16" cy="16" r="7" />
          <line x1="16" y1="16" x2="27" y2="9" />
        </svg>
        <span class="absolute -right-0.5 -top-0.5 w-2 h-2 rounded-full bg-accent ring-2 ring-paper"></span>
      </span>
      <span class="font-display text-[1.35rem] leading-none tracking-tight">
        Open<span class="italic">Radar</span>
      </span>
    </a>

    <nav class="flex items-center gap-7">
      <a
        href="/"
        class={`label transition-colors hover:text-accent ${isHome ? 'text-ink' : ''}`}
      >Index</a>
      <a
        href="/tags"
        class={`label transition-colors hover:text-accent ${isTags ? 'text-ink' : ''}`}
      >Tags</a>
      <a
        href="https://github.com"
        target="_blank"
        rel="noopener noreferrer"
        class="label flex items-center gap-1.5 transition-colors hover:text-accent"
      >
        Source
        <svg class="w-3 h-3" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 11l6-6M6 4.5h4.5V9" />
        </svg>
      </a>
    </nav>
  </div>
</header>
