---
const path = Astro.url.pathname;
const isHome = path === "/";
const isTags = path.startsWith("/tags");
---

<header
  class="sticky top-0 z-50 bg-surface/85 backdrop-blur-md border-b border-line"
>
  <div class="container-main flex items-center justify-between h-[4.25rem]">
    <!-- Brand lockup -->
    <a
      href="/"
      class="flex items-center gap-[var(--space-3)] group"
      aria-label="OpenRadar — home"
    >
      <span class="relative inline-flex">
        <svg
          class="w-7 h-7 text-text"
          viewBox="0 0 32 32"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          aria-hidden="true"
        >
          <circle cx="16" cy="16" r="13.5"></circle>
          <circle cx="16" cy="16" r="7"></circle>
          <line x1="16" y1="16" x2="27" y2="9"></line>
        </svg>
        <span
          class="absolute -right-0.5 -top-0.5 w-2 h-2 rounded-full bg-accent ring-2 ring-surface"
        ></span>
      </span>
      <span
        class="font-display text-[1.35rem] leading-none tracking-tight text-text"
      >
        Open<span class="italic">Radar</span>
      </span>
    </a>

    <div class="flex items-center gap-[var(--space-2)] md:gap-[var(--space-6)]">
      <!-- Desktop navigation -->
      <nav
        class="hidden md:flex items-center gap-[var(--space-6)]"
        aria-label="Primary"
      >
        <a
          href="/"
          aria-current={isHome ? "page" : undefined}
          class={`label transition-colors hover:text-accent ${isHome ? "text-accent" : ""}`}
          >Index</a
        >
        <a
          href="/tags"
          aria-current={isTags ? "page" : undefined}
          class={`label transition-colors hover:text-accent ${isTags ? "text-accent" : ""}`}
          >Tags</a
        >
      </nav>

      <!-- Theme toggle (always visible) -->
      <button
        type="button"
        data-theme-toggle
        aria-label="Toggle color theme"
        aria-pressed="false"
        class="inline-flex items-center justify-center w-11 h-11 rounded-md text-text-2 hover:text-accent hover:bg-surface-2 transition-colors"
      >
        <!-- Moon — shown in light mode (activate to go dark) -->
        <svg
          class="w-5 h-5 block dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
        <!-- Sun — shown in dark mode (activate to go light) -->
        <svg
          class="w-5 h-5 hidden dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4.2"></circle>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 2v2.5M12 19.5V22M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8 6 18M18 6l1.8-1.8"
          ></path>
        </svg>
      </button>

      <!-- Hamburger disclosure (mobile only) -->
      <button
        type="button"
        id="nav-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="group md:hidden inline-flex items-center justify-center w-11 h-11 rounded-md text-text-2 hover:text-accent hover:bg-surface-2 transition-colors"
      >
        <!-- Menu icon -->
        <svg
          class="w-5 h-5 block group-aria-[expanded=true]:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          aria-hidden="true"
        >
          <path stroke-linecap="round" d="M3.5 7h17M3.5 12h17M3.5 17h17"></path>
        </svg>
        <!-- Close icon -->
        <svg
          class="w-5 h-5 hidden group-aria-[expanded=true]:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          aria-hidden="true"
        >
          <path stroke-linecap="round" d="M5 5l14 14M19 5 5 19"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile navigation disclosure panel -->
  <nav
    id="mobile-nav"
    aria-label="Primary"
    class="hidden md:hidden border-t border-line bg-surface"
  >
    <div class="container-main flex flex-col py-2">
      <a
        href="/"
        aria-current={isHome ? "page" : undefined}
        class={`label flex items-center min-h-11 transition-colors hover:text-accent ${isHome ? "text-accent" : ""}`}
        >Index</a
      >
      <a
        href="/tags"
        aria-current={isTags ? "page" : undefined}
        class={`label flex items-center min-h-11 transition-colors hover:text-accent ${isTags ? "text-accent" : ""}`}
        >Tags</a
      >
    </div>
  </nav>
</header>

<script>
  // Theme toggle + mobile navigation disclosure (vanilla JS, no framework).
  const root = document.documentElement;
  const STORAGE_KEY = "or-theme";
  const THEME_COLOR = { light: "#f2ede2", dark: "#16140f" };

  const currentTheme = () => (root.dataset.theme === "dark" ? "dark" : "light");

  const sync = () => {
    const isDark = currentTheme() === "dark";
    document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
      btn.setAttribute("aria-pressed", String(isDark));
    });
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute("content", THEME_COLOR[currentTheme()]);
  };

  const applyTheme = (theme: "light" | "dark") => {
    root.dataset.theme = theme;
    try {
      localStorage.setItem(STORAGE_KEY, theme);
    } catch {
      /* storage unavailable — ignore, in-memory theme still applies */
    }
    sync();
  };

  document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      applyTheme(currentTheme() === "dark" ? "light" : "dark");
    });
  });

  // Initialize aria-pressed / theme-color from the pre-painted state.
  sync();

  // Mobile disclosure
  const navToggle = document.getElementById("nav-toggle");
  const mobileNav = document.getElementById("mobile-nav");
  if (navToggle && mobileNav) {
    const setOpen = (open: boolean) => {
      navToggle.setAttribute("aria-expanded", String(open));
      mobileNav.classList.toggle("hidden", !open);
    };
    navToggle.addEventListener("click", () => {
      setOpen(navToggle.getAttribute("aria-expanded") !== "true");
    });
    mobileNav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });
    document.addEventListener("keydown", (event) => {
      if (
        event.key === "Escape" &&
        navToggle.getAttribute("aria-expanded") === "true"
      ) {
        setOpen(false);
        navToggle.focus();
      }
    });
  }
</script>
