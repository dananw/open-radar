---
interface Props {
  name: string;
  /** "chip" = interactive filter pill (default); "mini" = compact flat card tag. */
  variant?: "chip" | "mini";
}

const { name, variant = "chip" } = Astro.props;
---

{
  variant === "mini" ? (
    <span class="tag-mini">
      <span class="tag-hash">#</span>
      {name}
    </span>
  ) : (
    <span class="chip">
      <span class="text-accent">#</span>
      {name}
    </span>
  )
}
