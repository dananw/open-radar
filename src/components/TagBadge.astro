---
interface Props {
  name: string
}

const { name } = Astro.props
---

<span
  class="inline-flex items-center gap-0.5 font-mono text-[0.7rem] leading-none
         px-2 py-1 border border-line bg-paper text-ink-2
         transition-colors group-hover:border-line-strong"
>
  <span class="text-accent">#</span>{name}
</span>
