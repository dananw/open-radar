---
import TagBadge from './TagBadge.astro'

interface Props {
  name: string
  description: string
  url: string
  stars?: number
  forks?: number
  language?: string
  tags: string[]
  slug: string
  index?: number
}

const { name, description, stars, forks, language, tags, slug, index } = Astro.props

function formatNumber(n: number): string {
  if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k'
  return n.toString()
}
---

<a
  href={`/projects/${slug}`}
  class="frame frame-hover group flex flex-col h-full w-full p-6"
>
  <div class="flex items-center justify-between mb-5">
    {index !== undefined ? (
      <span class="label text-ink-3">{String(index).padStart(2, '0')}</span>
    ) : (
      <span class="label text-ink-3">PROJECT</span>
    )}
    {language && (
      <span class="font-mono text-[0.7rem] text-ink-2 border border-line px-2 py-0.5 bg-paper">
        {language}
      </span>
    )}
  </div>

  <h3 class="font-display text-2xl leading-tight mb-3 group-hover:text-accent transition-colors">
    {name}
  </h3>

  <p class="text-sm text-ink-2 mb-5 line-clamp-2">
    {description}
  </p>

  <div class="flex flex-wrap gap-1.5 mb-6">
    {tags.slice(0, 4).map((tag) => <TagBadge name={tag} />)}
  </div>

  <div class="mt-auto pt-4 flex items-center gap-4 border-t border-line font-mono text-[0.7rem] text-ink-3">
    {stars !== undefined && (
      <span class="flex items-center gap-1">
        <span class="text-gold">★</span>{formatNumber(stars)}
      </span>
    )}
    {forks !== undefined && (
      <span class="flex items-center gap-1">
        <svg class="w-3 h-3" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="4" cy="3.5" r="1.6" />
          <circle cx="12" cy="3.5" r="1.6" />
          <circle cx="8" cy="12.5" r="1.6" />
          <path d="M4 5.1v1.4a2 2 0 002 2h4a2 2 0 002-2V5.1M8 8.5v2.4" />
        </svg>
        {formatNumber(forks)}
      </span>
    )}
    <span class="ml-auto inline-flex items-center gap-1 text-ink group-hover:text-accent transition-colors">
      Read
      <span class="inline-block transition-transform group-hover:translate-x-1">&rarr;</span>
    </span>
  </div>
</a>
