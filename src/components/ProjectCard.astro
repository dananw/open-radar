---
import TagBadge from './TagBadge.astro'

interface Props {
  name: string
  description: string
  url: string
  stars?: number
  forks?: number
  language?: string
  tags: string[]
  slug: string
}

const { name, description, url, stars, forks, language, tags, slug } = Astro.props

function formatNumber(n: number): string {
  if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k'
  return n.toString()
}
---

<a
  href={`/projects/${slug}`}
  class="glass-card group block p-6 no-underline hover:no-underline"
>
  <div class="flex items-start justify-between gap-3 mb-4">
    <h3 class="text-[1.25rem] font-semibold text-text-primary group-hover:text-accent transition-colors duration-200 font-display leading-snug">
      {name}
    </h3>
    {language && (
      <span class="text-xs font-mono text-text-muted shrink-0 px-2.5 py-1 rounded-md bg-surface-0/50 border border-white/[0.04]">
        {language}
      </span>
    )}
  </div>

  <p class="text-sm text-text-secondary mb-5 line-clamp-2" style="line-height: 1.6;">
    {description}
  </p>

  <div class="flex flex-wrap gap-2 mb-5">
    {tags.map((tag) => (
      <TagBadge name={tag} />
    ))}
  </div>

  <div class="flex items-center gap-4 pt-4 border-t border-white/[0.06]">
    {stars !== undefined && (
      <div class="flex items-center gap-1.5 text-xs text-text-muted">
        <svg class="w-3.5 h-3.5 text-warning" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        <span>{formatNumber(stars)}</span>
      </div>
    )}
    {forks !== undefined && (
      <div class="flex items-center gap-1.5 text-xs text-text-muted">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
        </svg>
        <span>{formatNumber(forks)}</span>
      </div>
    )}
    <div class="ml-auto">
      <span class="text-xs text-accent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        View details →
      </span>
    </div>
  </div>
</a>
