---
import TagBadge from "./TagBadge.astro";
import { formatNumber, padIndex, takeTags } from "../lib/format";

interface Props {
  name: string;
  description: string;
  url: string;
  stars?: number;
  forks?: number;
  language?: string;
  tags: string[];
  slug: string;
  index?: number;
}

const { name, description, stars, forks, language, tags, slug, index } =
  Astro.props;
---

<a
  href={`/projects/${slug}`}
  class="card surface-interactive group flex flex-col h-full w-full p-[var(--space-5)] sm:p-[var(--space-6)]"
>
  <!-- Meta row: index · editorial leader rule · language -->
  <div class="flex items-center gap-[var(--space-3)] mb-[var(--space-5)]">
    <span class="label card-index transition-colors">
      {index !== undefined ? padIndex(index) : "PROJECT"}
    </span>
    <span class="card-leader" aria-hidden="true"></span>
    {language && <span class="pill">{language}</span>}
  </div>

  <h3
    class="font-display text-2xl leading-tight mb-[var(--space-3)] text-balance group-hover:text-accent transition-colors"
  >
    {name}
  </h3>

  <p
    class="text-sm text-text-2 leading-relaxed mb-[var(--space-5)] line-clamp-4"
  >
    {description}
  </p>

  <div class="flex flex-wrap gap-[var(--space-2)] mb-[var(--space-5)]">
    {takeTags(tags).map((tag) => <TagBadge name={tag} variant="mini" />)}
  </div>

  <div
    class="mt-auto pt-[var(--space-4)] flex items-center gap-[var(--space-4)] border-t border-line font-mono text-[0.7rem] text-muted"
  >
    {
      stars !== undefined && (
        <span class="flex items-center gap-1.5">
          <span class="text-gold">★</span>
          {formatNumber(stars)}
        </span>
      )
    }
    {
      forks !== undefined && (
        <span class="flex items-center gap-1.5">
          <svg
            class="w-3 h-3"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <circle cx="4" cy="3.5" r="1.6" />
            <circle cx="12" cy="3.5" r="1.6" />
            <circle cx="8" cy="12.5" r="1.6" />
            <path d="M4 5.1v1.4a2 2 0 002 2h4a2 2 0 002-2V5.1M8 8.5v2.4" />
          </svg>
          {formatNumber(forks)}
        </span>
      )
    }
    <span
      class="ml-auto inline-flex items-center gap-1.5 font-semibold text-text group-hover:text-accent transition-colors"
    >
      Read
      <span class="inline-block transition-transform group-hover:translate-x-1"
        >&rarr;</span
      >
    </span>
  </div>
</a>

<style>
  /* Index number quietly warms to the accent as the card is engaged,
     reinforcing that the whole card is a single interactive target. */
  .card:hover .card-index,
  .card:focus-within .card-index {
    color: var(--accent);
  }

  /* Editorial "leader" rule between the index and the language pill —
     the catalog / table-of-contents device that ties the meta row
     together and fills the dead space the old layout left. */
  .card-leader {
    flex: 1 1 auto;
    height: 1px;
    background: linear-gradient(to right, var(--line-strong), transparent);
    opacity: 0.6;
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .card:hover .card-leader,
  .card:focus-within .card-leader {
    opacity: 1;
  }
</style>
